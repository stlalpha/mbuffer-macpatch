 64 Bit Buffers:
 ===============
-The buffer limit is sysconf(_SC_SEM_VALUE_MAX)*Blocksize. This usually
-limits the maximum number of blocks to 2G-1, because semaphores are
-implemented using an int, which is on most architectures a 32 Bit word.
-This limit is currently a non-issue, but might be resolved in a future
-release, by using condition variables.
+As of this version, the buffer size limitation has been removed by replacing
+POSIX semaphores with pthread condition variables and 64-bit counters. The
+previous limitation of sysconf(_SC_SEM_VALUE_MAX)*Blocksize (typically ~2GB
+due to 32-bit semaphore counters) no longer applies.
+
+Buffer size is now only limited by available system memory. The implementation
+uses volatile long long counters (64-bit) protected by mutexes, allowing buffer
+sizes well beyond the previous 2GB limitation.
 
 If the total buffer size is 2GB or larger, you will need to compile
 mbuffer as a 64bit executable. This requires that you have a 64bit
diff --git a/common.c b/common.c
index ae0fdfb..8ac48bd 100644
--- a/common.c
+++ b/common.c
@@ -189,3 +189,56 @@ const char *hBytes(unsigned long long v)
 }
 
 
+/*
+ * Condition variable-based counting synchronization primitives.
+ * These replace POSIX semaphores to remove the 2GB buffer limit.
+ *
+ * Semaphores are limited to INT_MAX (~2 billion), which restricts
+ * the number of buffer blocks. Using 64-bit counters with mutex+condvar
+ * removes this artificial limitation.
+ */
+
+void counter_init(volatile long long *counter, long long initial_value)
+{
+	*counter = initial_value;
+}
+
+void counter_wait(volatile long long *counter, pthread_mutex_t *mutex, pthread_cond_t *cond)
+{
+	int err = pthread_mutex_lock(mutex);
+	assert(err == 0);
+
+	while (*counter <= 0) {
+		err = pthread_cond_wait(cond, mutex);
+		assert(err == 0);
+	}
+
+	(*counter)--;
+
+	err = pthread_mutex_unlock(mutex);
+	assert(err == 0);
+}
+
+void counter_post(volatile long long *counter, pthread_mutex_t *mutex, pthread_cond_t *cond)
+{
+	int err = pthread_mutex_lock(mutex);
+	assert(err == 0);
+
+	(*counter)++;
+
+	err = pthread_cond_signal(cond);
+	assert(err == 0);
+
+	err = pthread_mutex_unlock(mutex);
+	assert(err == 0);
+}
+
+long long counter_getvalue(volatile long long *counter)
+{
+	/* Reading a volatile long long is atomic for the read operation.
+	 * We don't need a mutex here since this is only used for status
+	 * display, not for synchronization decisions. */
+	return *counter;
+}
+
+
